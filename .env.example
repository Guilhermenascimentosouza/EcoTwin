# Supabase (Public)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe (Public if using Stripe.js)
VITE_STRIPE_PUBLISHABLE_KEY=

# Supabase (Server - Vercel Functions only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Server - Vercel Functions only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ELITE_PRICE_ID=

# Helius (Server - Vercel Functions only)
# Used to validate USDC/USDT mint by fetching enhanced transaction details (fallback when webhook payload doesn't include mint)
HELIUS_API_KEY=
# Configure um Webhook no Helius apontando para /api/helius-webhook
# e defina um Authorization header no webhook. Coloque o mesmo valor aqui.
HELIUS_WEBHOOK_AUTH=

# App
PUBLIC_APP_URL=
