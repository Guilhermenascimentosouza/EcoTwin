# Supabase (Público - usado no Frontend/Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe (Público - só necessário se você usar Stripe.js no browser)
VITE_STRIPE_PUBLISHABLE_KEY=

# Supabase (Server - apenas Vercel Functions)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Server - apenas Vercel Functions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ELITE_PRICE_ID=

# Helius (Server - apenas Vercel Functions)
# Usado para validar o mint de USDC/USDT buscando detalhes enriquecidos da transação
# (fallback quando o payload do webhook não inclui o mint)

HELIUS_API_KEY=

# Configure um Webhook no Helius apontando para /api/helius-webhook
# e defina um Authorization header no webhook. Coloque o mesmo valor aqui.
HELIUS_WEBHOOK_AUTH=

# B2B (Server - apenas Vercel Functions)
# Segredo usado para hashear API keys B2B (nunca expor)
B2B_API_KEY_PEPPER=
# Segredo para criar API keys via /api/b2b-create-api-key (nunca expor)
B2B_ADMIN_SECRET=

# App
PUBLIC_APP_URL=
